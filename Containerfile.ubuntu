# AI CLI sandbox on Ubuntu 24.04 LTS: the coding agents, on top
# of the base image that base/Containerfile.ubuntu builds with
# everything else (development tools, linters, toolchains,
# database servers and client libraries).  The agents release
# far more often than anything in the base, so they are a
# separate image: rebuilding this file without the layer cache
# reruns only the steps below, while the base is rebuilt on its
# own schedule.
#
# Agents installed (command names in parentheses):
#   Claude Code (claude), Codex CLI (codex), Kiro CLI (kiro-cli),
#   opencode, openclaw, goose, pi, aider
#
# The agents that install the same way in every flavor come
# from scripts in tools/, as in the base; this file keeps what
# is specific to Ubuntu (the Kiro package).
#
# Build with update-aisandbox, which builds the base image when
# it is missing and then this file with --no-cache:
#
#   ./update-aisandbox
#
# Start with the start-aisandbox script.
#
# Note: the Kiro .deb is amd64-only; on arm64 replace that step
# with the zip from
# https://desktop-release.q.us-east-1.amazonaws.com/latest/kirocli-aarch64-linux.zip

# BASE names the base image; update-aisandbox passes the one it
# built (AISANDBOX_IMAGE with -base appended).  Both engines
# substitute an ARG declared before FROM into the FROM line.
ARG BASE=aisandbox-base
FROM ${BASE}

# The base image ends as its unprivileged user; the installs
# below write to /usr/local and /opt, so run them as root.
USER root

# Kiro CLI from the official Ubuntu package (installs system-wide,
# unlike the per-user https://cli.kiro.dev/install script).
RUN curl -fsSL -o /tmp/kiro-cli.deb \
        https://desktop-release.q.us-east-1.amazonaws.com/latest/kiro-cli.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/kiro-cli.deb \
    && rm -f /tmp/kiro-cli.deb \
    && rm -rf /var/lib/apt/lists/*

COPY tools/install-npm-agents.sh /opt/aisandbox/
RUN /opt/aisandbox/install-npm-agents.sh

COPY tools/install-goose.sh /opt/aisandbox/
RUN /opt/aisandbox/install-goose.sh

# aider, installed the way its own install script does (via uv)
# but into system-wide locations so any user can run it.  The
# base image holds a copy of the script already, for its Python
# linters, but this file copies its own so that an edit takes
# effect on the next agent build rather than the next base
# build.
COPY tools/install-uv-tools.sh /opt/aisandbox/
RUN /opt/aisandbox/install-uv-tools.sh aider-chat

# Updating inside a container makes no sense; pin what was built.
ENV DISABLE_AUTOUPDATER=1

# Back to the unprivileged user the base image created, by uid
# so that this file needs no USERNAME argument: the base renamed
# the stock ubuntu user (uid 1000) after the invoking host user,
# and 1000 is what open-shell and start-aisandbox use as well.
# Several agents complain when run as root.
USER 1000
