#!/bin/sh
# Start the aisandbox container (see Containerfile.ubuntu, the
# default image, and the other Containerfile.* variants)
# detached in the background, preferring podman and falling
# back to docker.  Open a shell inside it with open-shell.
#
# Mounts the source directory (default ~/.local/src) read/write,
# plus the per-tool config, cache, and state directories of the AI
# CLIs baked into the image, so logins and history persist across
# container runs.
#
# Usage: start-aisandbox [flavor] [source-dir]
#
# A first argument naming a Containerfile flavor next to this
# script selects it, like update-aisandbox (e.g.
# "start-aisandbox oracle" runs Containerfile.oracle's image);
# any other argument is the source directory.  The arguments
# take precedence over AISANDBOX_FLAVOR and AISANDBOX_SRC.
#
# Environment:
#   AISANDBOX_FLAVOR  Containerfile variant to run
#                     (default: ubuntu)
#   AISANDBOX_IMAGE   image to run (default: aisandbox for the
#                     ubuntu flavor, aisandbox-<flavor> for the
#                     others)
#   AISANDBOX_NAME    container name (default: same as the
#                     image default)
#   AISANDBOX_SRC     source directory mounted read/write and
#                     used as the working directory
#                     (default: ~/.local/src)
#
# Stop with stop-aisandbox; the container is removed
# automatically when stopped.
#
# The Oracle variant runs with the same command
# (AISANDBOX_FLAVOR=oracle): its image entrypoint starts the
# database and treats the idle command appended below as
# ignorable arguments.  See the Containerfile.oracle header
# for how to open shells in it.
#
# Each flavor gets its own container name (aisandbox,
# aisandbox-oracle, ...), so one container per Containerfile
# can run at a time and the flavors can run side by side.

set -eu

FLAVOR="${AISANDBOX_FLAVOR:-ubuntu}"
if [ $# -ge 1 ] && [ -f "$(dirname "$0")/Containerfile.${1}" ]; then
    FLAVOR="$1"
    shift
fi
if [ "${FLAVOR}" = "ubuntu" ]; then
    IMAGE="${AISANDBOX_IMAGE:-aisandbox}"
    NAME="${AISANDBOX_NAME:-aisandbox}"
else
    IMAGE="${AISANDBOX_IMAGE:-aisandbox-${FLAVOR}}"
    NAME="${AISANDBOX_NAME:-aisandbox-${FLAVOR}}"
fi
SRC="${1:-${AISANDBOX_SRC:-${HOME}/.local/src}}"

# Container engines require absolute paths in -v mounts, so
# resolve a relative source-dir argument against the current
# directory.
case "${SRC}" in
    /*) ;;
    *) SRC="$(pwd)/${SRC}" ;;
esac

if command -v podman >/dev/null 2>&1; then
    ENGINE="podman"
elif command -v docker >/dev/null 2>&1; then
    ENGINE="docker"
else
    echo "error: neither podman nor docker is installed" >&2
    exit 1
fi

if "${ENGINE}" container inspect "${NAME}" >/dev/null 2>&1; then
    echo "container '${NAME}' already exists;" \
        "stop it with stop-aisandbox" >&2
    exit 0
fi

# Home of the unprivileged user inside the image.  The image is
# built with a user named after the invoking host user (see
# update-aisandbox), so it matches the host home; agents key
# per-project state on absolute paths, and this keeps sessions
# resumable on both sides.
CHOME="${HOME}"

# Everything is built by PREPENDING to "$@" (options may appear
# in any order as long as they precede the image name), keeping
# the image and its idle command at the end.
set -- "${IMAGE}" sleep infinity

# Source tree, mounted read/write at the same absolute path on
# both sides (even when AISANDBOX_SRC points outside the home
# directory) so per-project agent state keyed on absolute paths
# matches on host and in the sandbox.
mkdir -p "${SRC}"
set -- -v "${SRC}:${SRC}" "$@"

# Host directories mounted read/write at the same relative
# location under the container user's home.  mkdir first so a
# missing directory is not created root-owned by the engine.
#
#   .aws                        AWS config, credentials, and SSO
#                               token cache (Kiro/Bedrock)
#   .claude                     Claude Code state and credentials
#   .kiro                       Kiro global config (hardcoded path)
#   .local/share/kiro-cli       Kiro CLI data
#   .opencode                   opencode config
#   .config/opencode            more opencode config
#   .local/share/opencode       opencode data (holds auth.json)
#   .local/state/opencode       opencode state
#   .cache/opencode             opencode cache
#   .openclaw                   OpenClaw workspace and config
#   .config/goose               goose config and secrets
#   .local/share/goose          goose sessions and data
#   .pi                         pi agent settings and sessions
#   .aider                      aider caches and analytics
for d in \
    .aws \
    .claude \
    .kiro \
    .local/share/kiro-cli \
    .config/opencode \
    .local/share/opencode \
    .local/state/opencode \
    .cache/opencode \
    .openclaw \
    .config/goose \
    .local/share/goose \
    .pi \
    .aider
do
    mkdir -p "${HOME}/${d}"
    set -- -v "${HOME}/${d}:${CHOME}/${d}" "$@"
done

# Claude Code also keeps global state (and, with some auth
# methods, credentials) in the single file ~/.claude.json; seed it
# so the mount is a file, not an engine-created directory.
[ -f "${HOME}/.claude.json" ] || printf '{}\n' > "${HOME}/.claude.json"
set -- -v "${HOME}/.claude.json:${CHOME}/.claude.json" "$@"

# Convenience files and directories, mounted read-only and only
# when they exist on the host.  The shell startup files cover
# every common sh/bash/zsh/ksh file so shells behave as they do
# on the host; ~/.cargo/env is included because ~/.zshenv
# commonly sources it.
for f in \
    .gitconfig \
    .quiltrc \
    .aider.conf.yml \
    .profile \
    .bashrc \
    .bash_profile \
    .bash_login \
    .bash_aliases \
    .inputrc \
    .zshrc \
    .zshenv \
    .zprofile \
    .zlogin \
    .zlogout \
    .kshrc \
    .cargo/env
do
    if [ -f "${HOME}/${f}" ]; then
        set -- -v "${HOME}/${f}:${CHOME}/${f}:ro" "$@"
    fi
done
if [ -d "${HOME}/.config/nvim" ]; then
    set -- -v "${HOME}/.config/nvim:${CHOME}/.config/nvim:ro" "$@"
fi

# Pass through common API keys, but only those actually set.
for v in ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY \
    OPENROUTER_API_KEY
do
    eval "val=\${${v}:-}"
    if [ -n "${val}" ]; then
        set -- -e "${v}" "$@"
    fi
done

# No D-Bus secret service exists inside the container; tell goose
# to keep secrets in ~/.config/goose instead of a keyring.
set -- -e GOOSE_DISABLE_KEYRING=1 "$@"

# Rootless podman: map the invoking user to uid/gid 1000 (the
# image's "ubuntu" user) so mounted files keep sane ownership on
# both sides.  Docker has no equivalent; ownership is correct
# there only if the host uid is already 1000.
if [ "${ENGINE}" = "podman" ]; then
    set -- --userns=keep-id:uid=1000,gid=1000 "$@"
fi

# --init makes PID 1 a real init that forwards SIGTERM, so
# "stop" is immediate instead of waiting out a 10 s timeout
# before SIGKILLing the idle sleep.
#
# --shm-size raises /dev/shm above the engines' 64 MB default:
# the Oracle variant's database keeps its SGA there, and tmpfs
# pages cost nothing until written, so the ubuntu image is
# unaffected.
#
# All flavors share the host network, so servers a flavor runs
# (the oracle flavor's database listener on 1521) bind their
# ports directly on the host.
set -- run -d --rm --init --name "${NAME}" --hostname "${NAME}" \
    --network host --shm-size=2g -w "${SRC}" "$@"

"${ENGINE}" "$@" >/dev/null
echo "container '${NAME}' started;" \
    "open a shell with open-shell"
