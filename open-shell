#!/bin/sh
# Open an interactive shell, or run a command, in the aisandbox
# container, starting the container first when it is not running
# already.
#
# Usage: open-shell [flavor] [-k | -s] [-r | -u user]
#                   [command [args ...]]
#   With no arguments an interactive login shell is started.
#
# A first argument naming a Containerfile flavor next to this
# script selects which flavor's container to use, like
# start-aisandbox (e.g. "open-shell oracle"); it takes
# precedence over AISANDBOX_FLAVOR.  Everything after the
# options is the command to run.
#
# Options:
#   -k       leave the container running on exit, even when this
#            invocation started it
#   -s       stop the container on exit when nothing else is
#            using it, even when it was already running
#   -r       run as root inside the container
#   -u user  run as the given container user (e.g. -u oracle
#            for the Oracle variant's database user)
#
# A container this invocation had to start is stopped again when
# the shell exits and no other session is using it, so a sandbox
# started only to run one command does not outlive it.  A
# container that was already running is left alone unless -s says
# otherwise, since it may have been started for something else
# (the oracle flavor's database serves the host whether a session
# is attached or not).
#
# Shells start in the host's current directory when the
# container can see it, which it can for anything under the
# mounted source tree, since that is mounted at the same
# absolute path on both sides.  Otherwise they start in the
# container's own working directory (the mounted source tree).
#
# Shells default to the uid-1000 agent user every flavor's
# image builds: the ubuntu image's default user already is it,
# while the other flavors' images default to a service user
# (the oracle image's must stay oracle so its entrypoint can
# start the database), so the exec selects uid 1000 there
# explicitly.
#
# Environment:
#   AISANDBOX_FLAVOR  Containerfile variant whose container to
#                     use (default: ubuntu)
#   AISANDBOX_NAME    container name (default: aisandbox for
#                     the ubuntu flavor, aisandbox-<flavor> for
#                     the others)
#   AISANDBOX_SRC     source directory start-aisandbox mounts,
#                     when this script has to start the
#                     container (default: ~/.local/src)

set -eu

# Follow a symlink back to the real script before taking its
# directory, so the shared library and the Containerfiles next
# to it are still found when the script is reached through a
# symlink in PATH.
SELF="$0"
while [ -L "${SELF}" ]; do
    LINK="$(readlink "${SELF}")"
    case "${LINK}" in
        /*) SELF="${LINK}" ;;
        *) SELF="$(dirname "${SELF}")/${LINK}" ;;
    esac
done
DIR="$(dirname "${SELF}")"
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "${DIR}/lib.sh"

select_flavor "$@"
shift "${FLAVOR_SHIFT}"

# The uid-1000 default (see above) is numeric so it works no
# matter which host user's name the image was built with.
if [ "${FLAVOR}" = "ubuntu" ]; then
    ASUSER=""
else
    ASUSER="--user 1000"
fi

# Empty means the default: stop only a container this invocation
# started.
STOP=""
while getopts kru:s opt; do
    case "${opt}" in
        k) STOP="no" ;;
        r) ASUSER="--user root" ;;
        s) STOP="yes" ;;
        u) ASUSER="--user ${OPTARG}" ;;
        *)
            echo "usage: open-shell [flavor] [-k | -s]" \
                "[-r | -u user] [command [args ...]]" >&2
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

find_engine

# start-aisandbox is a no-op on an existing container, but it
# says so on stderr, so ask first and stay quiet when there is
# nothing to start.
if "${ENGINE}" container inspect "${NAME}" >/dev/null 2>&1; then
    STOP="${STOP:-no}"
else
    "${DIR}/start-aisandbox" "${FLAVOR}"
    STOP="${STOP:-yes}"
fi

# Count the sessions entered from outside the container.  Both
# engines run an exec session inside the container's PID
# namespace while its parent (conmon, or the daemon's shim) stays
# outside, and the kernel reports a parent it cannot see in the
# namespace as PPid 0.  Nothing else has that: PID 1, the idle
# sleep, and whatever the image itself starts (the oracle
# flavor's database) all descend from PID 1, and orphans are
# reparented to it.  The count includes the exec session doing
# the counting, so "nothing else is using it" means 1.
sessions() {
    "${ENGINE}" exec "${NAME}" sh -c '
        n=0
        for p in /proc/[0-9]*; do
            [ "${p}" = "/proc/1" ] && continue
            ppid=""
            while read -r key value; do
                if [ "${key}" = "PPid:" ]; then
                    ppid="${value}"
                    break
                fi
            done < "${p}/status" 2>/dev/null || continue
            [ "${ppid}" = "0" ] && n=$((n + 1))
        done
        echo "${n}"
    '
}

# Both engines fail an exec whose working directory does not
# exist in the container, so use the host's current directory
# only after checking for it inside, and fall back to the
# working directory the container itself was started with.
WD="$(pwd)"
if ! "${ENGINE}" exec "${NAME}" sh -c 'test -d "${1}"' sh "${WD}" \
    >/dev/null 2>&1
then
    WD="$("${ENGINE}" container inspect \
        --format '{{.Config.WorkingDir}}' "${NAME}")"
    [ -n "${WD}" ] || WD="/"
fi

# Start the same shell used on the host when the image has it,
# falling back to zsh then bash.
if [ $# -eq 0 ]; then
    hostsh="${SHELL##*/}"
    set -- sh -c 'for s in '"${hostsh}"' zsh bash; do
        command -v "${s}" >/dev/null && exec "${s}" -l
    done
    exec sh -l'
fi

# Allocate a tty only when we actually have one, so commands can
# also be run from pipes and scripts.  ${ASUSER} is expanded
# unquoted on purpose: it is either empty or "--user <user>".
if [ -t 0 ]; then
    set -- exec ${ASUSER} -w "${WD}" -it "${NAME}" "$@"
else
    set -- exec ${ASUSER} -w "${WD}" -i "${NAME}" "$@"
fi

# With nothing left to do afterwards, hand the terminal over for
# good; the command's exit status is then this script's own.
if [ "${STOP}" = "no" ]; then
    exec "${ENGINE}" "$@"
fi

STATUS=0
"${ENGINE}" "$@" || STATUS=$?

# A count that is missing or not a number means the container is
# gone or unreachable, which is nothing to stop either way.
COUNT="$(sessions 2>/dev/null)" || COUNT=""
case "${COUNT}" in
    ''|*[!0-9]*) ;;
    *)
        if [ "${COUNT}" -le 1 ]; then
            "${DIR}/stop-aisandbox" "${FLAVOR}"
        fi
        ;;
esac

exit "${STATUS}"
