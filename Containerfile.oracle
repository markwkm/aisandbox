# AI CLI sandbox with Oracle Database Free, on Oracle Linux 8:
# the coding agents, on top of the base image that
# base/Containerfile.oracle builds on Oracle's official Oracle
# Database Free image.  The agents are a separate image for the
# reason Containerfile.ubuntu gives, and the base header
# describes the tools, what is left out compared with the
# Ubuntu flavor, and what is substituted.
#
# Agents installed (command names in parentheses):
#   Claude Code (claude), Codex CLI (codex), opencode, openclaw,
#   goose, pi, aider
#
# Kiro CLI is left out: it is only distributed as an Ubuntu
# .deb.
#
# Build with "./update-aisandbox oracle", which builds the base
# image when it is missing and then this file with --no-cache,
# both in docker image format so the HEALTHCHECK from Oracle's
# image survives.  Start with
#
#   ./start-aisandbox oracle
#
# which also names the container aisandbox-oracle, so it can
# run alongside the default ubuntu sandbox.
#
# The database is not started: start-aisandbox's idle command
# replaces the CMD inherited from Oracle's image.  That image
# ships the FREE database already created but stopped, and
# whatever needs a database starts it (or recreates it) with
# the software home's tools as the oracle user (uid 54321;
# DBT-2's oracle integration test does exactly that and leaves
# the database running for later runs).  The oracle account's
# password is "oracle", set by Oracle's image.  Agent work
# happens as the unprivileged uid-1000 user the base image
# creates, which open-shell selects by default for this flavor
# ("open-shell oracle -u oracle" reaches the database user):
#
#   ./open-shell oracle
#
# start-aisandbox runs every flavor on the host network, so a
# listener started in the container binds port 1521 on the
# host.  Database data lives in /opt/oracle/oradata and is not
# persisted across container removal.

# BASE names the base image; update-aisandbox passes the one it
# built (AISANDBOX_IMAGE with -base appended).
ARG BASE=aisandbox-oracle-base
FROM ${BASE}

# The base image ends as the oracle user; the installs below
# write to /usr/local and /opt, so run them as root.
USER root

COPY tools/install-npm-agents.sh /opt/aisandbox/
RUN /opt/aisandbox/install-npm-agents.sh

COPY tools/install-goose.sh /opt/aisandbox/
RUN /opt/aisandbox/install-goose.sh

# aider, installed the way its own install script does (via uv)
# but into system-wide locations so any user can run it.  The
# base image holds a copy of the script already, for its Python
# linters, but this file copies its own so that an edit takes
# effect on the next agent build rather than the next base
# build.
COPY tools/install-uv-tools.sh /opt/aisandbox/
RUN /opt/aisandbox/install-uv-tools.sh aider-chat

# Updating inside a container makes no sense; pin what was built.
ENV DISABLE_AUTOUPDATER=1

# Back to the oracle user, the default the base image ends
# with; open-shell selects the uid-1000 user for agent work
# itself.
USER oracle
