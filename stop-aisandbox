#!/bin/sh
# Stop the aisandbox container started by start-aisandbox.  The
# container removes itself when stopped.
#
# Usage: stop-aisandbox [flavor]
#
# The optional flavor argument names a Containerfile.<flavor>
# next to this script and selects which flavor's container to
# stop, like start-aisandbox (default: ubuntu); it takes
# precedence over AISANDBOX_FLAVOR.
#
# Environment:
#   AISANDBOX_FLAVOR  Containerfile variant whose container to
#                     stop (default: ubuntu)
#   AISANDBOX_NAME    container name (default: aisandbox for
#                     the ubuntu flavor, aisandbox-<flavor> for
#                     the others)

set -eu

# Follow a symlink back to the real script before taking its
# directory, so the shared library next to it is still found
# when the script is reached through a symlink in PATH.
SELF="$0"
while [ -L "${SELF}" ]; do
    LINK="$(readlink "${SELF}")"
    case "${LINK}" in
        /*) SELF="${LINK}" ;;
        *) SELF="$(dirname "${SELF}")/${LINK}" ;;
    esac
done
DIR="$(dirname "${SELF}")"
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "${DIR}/lib.sh"

select_flavor "$@"
shift "${FLAVOR_SHIFT}"
if [ $# -gt 0 ]; then
    echo "usage: stop-aisandbox [flavor]" >&2
    exit 1
fi
find_engine

if ! "${ENGINE}" container inspect "${NAME}" >/dev/null 2>&1; then
    echo "container '${NAME}' is not running" >&2
    exit 0
fi

# -t raises the SIGKILL timeout above the 10 s default: the
# Oracle variant shuts its database down on SIGTERM, which can
# take longer than 10 s, while the ubuntu image's idle sleep
# exits immediately either way.
"${ENGINE}" stop -t 60 "${NAME}" >/dev/null
echo "container '${NAME}' stopped"
